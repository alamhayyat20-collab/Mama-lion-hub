rules_version = '2';
// Dipublish automatik oleh GitHub Actions (.github/workflows/deploy-rules.yml) - dikemas kini 19 Nov 2026 (pegawai kewangan, unit Pejabat & Media, daftar aset)
service cloud.firestore {
  match /databases/{database}/documents {
    // Akaun Firebase khas telefon pekerja (Apps Pekerja) - akses terhad
    function staffApp() {
      return request.auth != null && request.auth.token.email in ['alamhayyat20+pekerja@gmail.com', 'pekerja@mamalion.app'];
    }
    // Akaun dalaman: peranti kaunter & pengurusan (bukan akaun Apps Pekerja)
    function dalaman() {
      return request.auth != null && !staffApp();
    }
    function pemilikAkaun() {
      return request.auth != null
        && exists(/databases/$(database)/documents/akaun/mama-lion/pemilik/$(request.auth.uid));
    }

    // Pegawai kewangan syarikat (Petunjuk Pictures) — didaftar pemilik ikut emel log masuk
    function kewanganSyarikat() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/akaun/mama-lion/kewangan/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/akaun/mama-lion/kewangan/$(request.auth.token.email.lower())).data.aktif != false;
    }
    match /akaun/mama-lion/kewangan/{emel} {
      allow get: if request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == emel;
      allow read, write: if pemilikAkaun();
    }
    // Daftar aset syarikat (susut nilai) — pemilik & pegawai kewangan
    match /akaun/syarikat/aset/{id} {
      allow read, write: if pemilikAkaun() || kewanganSyarikat();
    }
    // Memo perakaunan & audit (senarai semak dokumen, nota)
    match /akaun/syarikat/memo/{id} {
      allow read, write: if pemilikAkaun() || kewanganSyarikat();
    }

    // Dokumen peribadi pekerja (IC, kontrak, sijil) — pemilik Akaun sahaja
    match /dokumen_staf/{id} {
      allow read, write: if pemilikAkaun();
    }
    match /branches/{branchId} {
      allow read, write: if dalaman();
    }
    match /staff/{staffId} {
      allow read: if dalaman();
      allow write: if false;
    }

    // Lion Safari V2 - peranti kaunter
    match /lionsafari/{cawangan}/{document=**} {
      allow read, write: if dalaman();
    }
    // Apps Pekerja hanya baca senarai staf (untuk semak ID + PIN)
    match /lionsafari/{cawangan}/staf/{id} {
      allow read: if staffApp();
      // Kuasa 👥 Urus pekerja: maklumat asas sahaja (bukan kuasa, MO, Admin/Manager, atau diri sendiri)
      allow create: if staffApp() && cawangan == 'mama-lion'
        && olehKuasa('mama-lion', 'urus')
        && request.resource.data.peranan in ['Pekerja', 'Sales', 'Cashier', 'Supervisor']
        && request.resource.data.mo == false && request.resource.data.kuasa.size() == 0
        && request.resource.data.keys().hasOnly(['nama', 'idStaf', 'peranan', 'telefon', 'jawatan', 'jenisPekerja', 'tarikhMula', 'punchBebas', 'aktif',
          'pinHash', 'mo', 'kuasa', 'dicipta', 'dikemaskiniOleh', 'olehId', 'olehCaw']);
      allow update: if staffApp() && cawangan == 'mama-lion'
        && olehKuasa('mama-lion', 'urus')
        && request.resource.data.olehId != id
        && resource.data.get('peranan', 'Pekerja') in ['Pekerja', 'Sales', 'Cashier', 'Supervisor']
        && request.resource.data.peranan in ['Pekerja', 'Sales', 'Cashier', 'Supervisor']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'idStaf', 'peranan', 'telefon', 'jawatan', 'jenisPekerja', 'tarikhMula',
          'punchBebas', 'aktif', 'pinHash', 'dikemaskiniOleh', 'olehId', 'olehCaw']);
    }
    // Apps Pekerja baca gambar profil staf (untuk Kad ID & skrin PIN); hanya pengurusan boleh tukar
    match /lionsafari/{cawangan}/staf_foto/{id} {
      allow read: if staffApp();
    }
    // Kuasa pengelola yang ditanda oleh pemilik (lionsafari/{c}/staf/{id}.kuasa.{k})
    function kuasa(c, id, k) {
      let st = get(/databases/$(database)/documents/lionsafari/mama-lion/staf/$(id)).data;
      return st.get('kuasa', {}).get(k, false) == true && st.get('aktif', true) != false;
    }
    function olehKuasa(c, k) {
      return request.resource.data.olehId is string && kuasa(c, request.resource.data.olehId, k);
    }
    // Apps Pekerja (MO): baca order & kadar komisen; cipta order hanya oleh staf yang diaktifkan MO
    function moSah(cawangan, d) {
      let st = get(/databases/$(database)/documents/lionsafari/mama-lion/staf/$(d.moId)).data;
      return st.get('mo', false) == true && st.get('aktif', true) != false;
    }
    match /lionsafari/{cawangan}/order/{id} {
      allow read: if staffApp();
      allow create: if staffApp()
        && request.resource.data.sumber == 'apps-pekerja'
        && request.resource.data.status == 'Menunggu'
        && request.resource.data.aktif == true
        && request.resource.data.moId is string
        && request.resource.data.mo.id == request.resource.data.moId
        && !('bayar' in request.resource.data)
        && request.resource.data.dibuat == request.time
        && moSah(cawangan, request.resource.data);
      // Kuasa 💳 Kaunter: terima tempahan pelanggan sebagai order
      allow create: if staffApp()
        && request.resource.data.sumber == 'tempahan'
        && request.resource.data.status == 'Menunggu'
        && request.resource.data.aktif == true
        && !('bayar' in request.resource.data)
        && olehKuasa(cawangan, 'kaunter');
      // Kuasa 💳 Kaunter: progress servis, bay, bayaran & cop (bukan harga/pakej)
      allow update: if staffApp()
        && olehKuasa(cawangan, 'kaunter')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'masaMenunggu', 'masaCuci', 'masaKering', 'masaQC', 'masaSiap', 'bay',
          'dikemaskiniOleh', 'olehId', 'olehCaw', 'bayar', 'diskaun', 'diskaunLulus', 'jumlah', 'aktif', 'tarikhBayar', 'bulanBayar', 'dibayarOleh', 'masaBayar',
          'copInfo', 'copGagal', 'cop'])
        && request.resource.data.status in ['Menunggu', 'Cuci', 'Kering', 'QC', 'Siap', 'Selesai']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bayar', 'jumlah', 'diskaun'])
            || (resource.data.get('freeWash', null) == null
                && ((request.resource.data.get('diskaun', 0) == 0 && request.resource.data.jumlah == resource.data.jumlahKasar)
                    || (resource.data.get('diskaunBeri', null) != null
                        && request.resource.data.diskaun == resource.data.diskaunBeri.amaun
                        && request.resource.data.jumlah == resource.data.jumlahKasar - resource.data.diskaunBeri.amaun))));
      // Kuasa ✏️ Edit: betulkan butiran order dalam queue (sebelum bayaran; jumlah = jumlah kasar)
      allow update: if staffApp()
        && olehKuasa(cawangan, 'edit')
        && resource.data.aktif == true && !('bayar' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plat', 'kenderaan', 'pakejId', 'pakej', 'hargaPakej', 'tambahanKenderaan', 'addon', 'itemManual',
          'jumlahKasar', 'jumlah', 'catatan', 'komisen', 'sejarahEdit', 'dikemaskiniOleh', 'olehId', 'olehCaw'])
        && request.resource.data.jumlah == request.resource.data.jumlahKasar
        && request.resource.data.jumlahKasar is number && request.resource.data.jumlahKasar >= 0;
      // Kuasa 🔧 Progress: kemas kini status servis & bay (tiada bayaran)
      allow update: if staffApp()
        && olehKuasa(cawangan, 'progress')
        && resource.data.aktif == true && !('bayar' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'masaMenunggu', 'masaCuci', 'masaKering', 'masaQC', 'masaSiap', 'bay', 'dikemaskiniOleh', 'olehId', 'olehCaw'])
        && request.resource.data.status in ['Menunggu', 'Cuci', 'Kering', 'QC', 'Siap'];
      // Kuasa 🎟 Lulus diskaun: beri / batal diskaun RM5, RM10, RM20 sebelum bayaran
      allow update: if staffApp()
        && olehKuasa(cawangan, 'diskaun')
        && resource.data.aktif == true && !('bayar' in resource.data)
        && (resource.data.get('diskaunBeri', null) == null || resource.data.diskaunBeri.get('sumber', '') != 'akaun')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diskaunBeri', 'diskaunMinta', 'olehId', 'olehCaw', 'dikemaskiniOleh'])
        && (request.resource.data.get('diskaunBeri', null) == null
            || (request.resource.data.diskaunBeri.amaun in [5, 10, 20] && request.resource.data.diskaunBeri.olehId == request.resource.data.olehId));
    }
    // Cermin order untuk Apps Pelanggan bayar sendiri (dibaca dengan no. plat; tiada nama / telefon)
    match /lionsafari/{cawangan}/bayar_awam/{plat} {
      allow get: if true;
      allow write: if staffApp();
    }
    // Bayaran oleh pelanggan melalui Apps Pelanggan (QR / Transfer + bukti) — disahkan oleh kaunter
    match /lionsafari/{cawangan}/bayar_pelanggan/{id} {
      allow get: if true;
      allow read: if staffApp();
      allow create: if request.resource.data.status == 'menunggu'
        && request.resource.data.keys().hasOnly(['orderId', 'plat', 'no', 'jumlah', 'amaunBayar', 'tepat', 'kaedah', 'rujukan', 'bukti', 'nama', 'telefon', 'ahliKod', 'status', 'masa', 'masaPeranti'])
        && request.resource.data.orderId is string
        && request.resource.data.jumlah is number
        && (!('amaunBayar' in request.resource.data) || request.resource.data.amaunBayar is number)
        && request.resource.data.kaedah in ['QR / eWallet', 'Transfer']
        && request.resource.data.bukti is string && request.resource.data.bukti.size() > 100 && request.resource.data.bukti.size() < 900000
        && request.resource.data.masa == request.time
        && exists(/databases/$(database)/documents/lionsafari/$(cawangan)/order/$(request.resource.data.orderId));
    }
    // Gambar keadaan asal kenderaan (dalam, calar, kondisi) oleh pekerja kuasa 🔧 Progress / 💳 Kaunter
    match /lionsafari/{cawangan}/foto_keadaan/{id} {
      allow read: if staffApp();
      allow create: if staffApp()
        && (olehKuasa(cawangan, 'progress') || olehKuasa(cawangan, 'kaunter'))
        && request.resource.data.gambar is string && request.resource.data.gambar.size() < 900000
        && request.resource.data.orderId is string
        && exists(/databases/$(database)/documents/lionsafari/$(cawangan)/order/$(request.resource.data.orderId));
    }
    match /lionsafari/{cawangan}/order_gambar/{id} {
      allow read: if staffApp();
      allow create: if staffApp()
        && exists(/databases/$(database)/documents/lionsafari/$(cawangan)/order/$(id));
    }
    // Daily Report Duty: pekerja kuasa 👀 Hadir rekod PIC & catatan
    match /kakitangan/{cawangan}/duty/{id} {
      allow read: if staffApp();
      allow write: if staffApp() && olehKuasa('mama-lion', 'hadir')
        && request.resource.data.get('disahkanOleh', '') == resource.data.get('disahkanOleh', '');
    }
    // Tutup kaunter: kuasa 🔐 Tutup (gambar & kiraan tunai), kuasa 🧮 Semak (sahkan / pulangkan)
    match /lionsafari/{cawangan}/tutup/{tarikh} {
      allow read: if staffApp();
      allow create: if staffApp() && olehKuasa(cawangan, 'tutup')
        && request.resource.data.status == 'draf'
        && request.resource.data.keys().hasOnly(['tarikh', 'bulan', 'cawangan', 'status', 'fotoOleh', 'fotoMasa', 'tunaiDikira', 'kiraan2', 'dikemaskini', 'olehId', 'olehCaw']);
      allow update: if staffApp() && (
        (olehKuasa(cawangan, 'tutup') && resource.data.get('status', 'draf') == 'draf' && request.resource.data.status == 'draf'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tarikh', 'bulan', 'cawangan', 'status', 'fotoOleh', 'fotoMasa', 'tunaiDikira', 'kiraan2', 'dikemaskini', 'olehId', 'olehCaw']))
        || (olehKuasa(cawangan, 'semak') && resource.data.status == 'dihantar' && request.resource.data.status in ['disahkan', 'draf']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tarikh', 'bulan', 'cawangan', 'status', 'disemakOleh', 'masaSemak', 'catatanSemak', 'dikemaskini', 'olehId', 'olehCaw'])));
    }
    match /lionsafari/{cawangan}/tutup_foto/{tarikh} {
      allow read: if staffApp();
      allow write: if staffApp() && olehKuasa(cawangan, 'tutup')
        && (!exists(/databases/$(database)/documents/lionsafari/$(cawangan)/tutup/$(tarikh))
            || get(/databases/$(database)/documents/lionsafari/$(cawangan)/tutup/$(tarikh)).data.get('status', 'draf') == 'draf');
    }
    // Lampiran / dokumen tutup kaunter (resit supplier, slip bank, penyata QR…)
    match /lionsafari/{cawangan}/tutup_lampiran/{id} {
      allow read: if staffApp();
      allow create: if staffApp() && (olehKuasa(cawangan, 'tutup') || olehKuasa(cawangan, 'semak'))
        && request.resource.data.tarikh is string && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if staffApp()
        && (!exists(/databases/$(database)/documents/lionsafari/$(cawangan)/tutup/$(resource.data.tarikh))
            || get(/databases/$(database)/documents/lionsafari/$(cawangan)/tutup/$(resource.data.tarikh)).data.get('status', 'draf') == 'draf');
    }
    // Tempahan dari Apps Pelanggan
    match /lionsafari/{cawangan}/tempahan/{id} {
      allow get: if true;
      allow list: if dalaman() || staffApp();
      allow create: if cawangan in ['mama-lion', 'lion-king']
        && request.resource.data.status == 'baru'
        && request.resource.data.ahliId is string
        && request.resource.data.plat is string && request.resource.data.plat.size() < 20
        && request.resource.data.telefon == get(/databases/$(database)/documents/ahli/$(request.resource.data.ahliId)).data.telefon;
      allow update: if dalaman()
        || (staffApp() && olehKuasa(cawangan, 'kaunter') && resource.data.status == 'baru')
        || (resource.data.status == 'baru' && request.resource.data.status == 'batal'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dikemaskini']));
    }
    match /lionsafari/{cawangan}/tetapan/komisen {
      allow read: if staffApp();
    }

    // Lion Safari V2 hantar jualan (ls-), petty cash (lsp-) & tutup kaunter (tk-: consumables laci, minyak kenderaan syarikat) ke Akaun
    match /akaun/{cawangan}/entri/{id} {
      allow create, update: if dalaman() && cawangan in ['mama-lion', 'lion-king']
        && (id.matches('ls-.*') || id.matches('lsp-.*') || id.matches('tk-.*'))
        && request.resource.data.sumber == 'lionsafari'
        && request.resource.data.cawangan == cawangan;
      allow delete: if dalaman() && cawangan in ['mama-lion', 'lion-king']
        && (id.matches('ls-.*') || id.matches('lsp-.*') || id.matches('tk-.*'));
      // Kuasa 💳 Kaunter (Apps Pekerja): jualan harian hasil bayaran
      allow get: if staffApp() && id.matches('ls-.*');
      allow create, update: if staffApp() && id.matches('ls-.*')
        && request.resource.data.sumber == 'lionsafari'
        && request.resource.data.cawangan == cawangan
        && olehKuasa(cawangan, 'kaunter');
    }
    match /akaun/{cawangan}/entri/{id} {
      // Unit syarikat (Pejabat / HQ, Pengiklanan & Media): pemilik & pegawai kewangan sahaja
      allow read, write: if cawangan in ['pejabat', 'media'] && (pemilikAkaun() || kewanganSyarikat());
      allow read, write: if !(cawangan in ['pejabat', 'media']) && cawangan != 'mama-lion' && dalaman();
    }

    // Rekod pekerja (IC, gaji, bank) & advance/OT manual: pemilik sahaja
    match /akaun/{cawangan}/pekerja/{id} {
      allow read, write: if pemilikAkaun();
    }
    match /akaun/{cawangan}/hr/{id} {
      allow read, write: if pemilikAkaun();
    }

    // Kakitangan: kehadiran, permohonan, roster (kaunter & Akaun urus semua)
    match /kakitangan/{cawangan}/{document=**} {
      allow read, write: if dalaman();
    }
    // Apps Pekerja: punch in/out - masa mesti masa server
    match /kakitangan/{cawangan}/kehadiran/{id} {
      allow read: if staffApp();
      allow create: if staffApp()
        && request.resource.data.masa == request.time
        && request.resource.data.jenis in ['masuk', 'keluar'];
    }
    match /kakitangan/{cawangan}/kehadiran_gambar/{id} {
      allow read: if staffApp();
      allow create: if staffApp()
        && exists(/databases/$(database)/documents/kakitangan/$(cawangan)/kehadiran/$(id));
    }
    // Apps Pekerja: hantar permohonan advance / claim / OT (status mesti menunggu)
    match /kakitangan/{cawangan}/permohonan/{id} {
      allow read: if staffApp();
      // Pengelola: lulus / tolak OT & cuti (kuasa lulus), tukar syif (kuasa roster). Advance & claim: pemilik sahaja.
      allow update: if staffApp()
        && resource.data.status == 'menunggu'
        && resource.data.jenis in ['ot', 'cuti', 'tukar']
        && request.resource.data.status in ['lulus', 'tolak']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'diprosesOleh', 'diproses', 'jamLulus', 'catatanLulus', 'olehId', 'olehCaw'])
        && olehKuasa(cawangan, resource.data.jenis == 'tukar' ? 'roster' : 'lulus');
      allow create: if staffApp()
        && request.resource.data.status == 'menunggu'
        && request.resource.data.masa == request.time;
    }
    match /kakitangan/{cawangan}/roster/{id} {
      allow read: if staffApp();
      allow create, update: if staffApp() && (olehKuasa(cawangan, 'roster') || olehKuasa(cawangan, 'lulus'));
    }
    // Log tindakan pengelola (dibaca pemilik di Akaun)
    match /kakitangan/{cawangan}/log/{id} {
      allow create: if staffApp() && request.resource.data.masa == request.time
        && request.resource.data.stafId == request.resource.data.olehId && olehKuasaMana(cawangan);
      // Masuk kaunter dengan ID Akaun (pengurusan): direkod automatik
      allow create: if dalaman() && request.resource.data.masa == request.time && request.resource.data.idStaf == 'AKAUN'
        && request.resource.data.stafId == 'akaun-' + request.auth.uid;
    }
    function olehKuasaMana(c) {
      return request.resource.data.olehId is string
        && get(/databases/$(database)/documents/lionsafari/mama-lion/staf/$(request.resource.data.olehId)).data.get('kuasa', {}).size() > 0;
    }
    // Arahan pemilik: tugasan & chat (pekerja dengan kuasa chat)
    match /kakitangan/{cawangan}/tugas/{id} {
      allow read: if staffApp();
      allow update: if staffApp()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'nota', 'bukti', 'masaStatus'])
        && request.resource.data.status in ['diterima', 'sedang', 'selesai']
        && kuasa(cawangan, resource.data.stafId, 'chat');
    }
    match /kakitangan/{cawangan}/mesej/{id} {
      allow read: if staffApp();
      allow create: if staffApp()
        && request.resource.data.dari == 'staf'
        && request.resource.data.masa == request.time
        && request.resource.data.stafId is string
        && kuasa(cawangan, request.resource.data.stafId, 'chat');
      allow update: if staffApp()
        && resource.data.dari == 'pemilik'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dibaca']);
    }
    match /kakitangan/{cawangan}/tetapan/{id} {
      allow read: if staffApp();
    }
    // Apps Pekerja: memo, buku peraturan kerja & SOP; pekerja sahkan "sudah baca"
    match /kakitangan/{cawangan}/info/{id} {
      allow read: if staffApp();
      allow create, update: if staffApp() && olehKuasa(cawangan, 'info');
    }
    match /kakitangan/{cawangan}/info_lampiran/{id} {
      allow read: if staffApp();
    }
    match /kakitangan/{cawangan}/info_baca/{id} {
      allow read: if staffApp();
      allow create: if staffApp()
        && id == request.resource.data.infoId + '__' + request.resource.data.stafId
        && request.resource.data.masa == request.time;
    }

    // Safari Members (Apps Pelanggan): akses awam terhad
    function sahAhliBaru(token) {
      let d = request.resource.data;
      return token.size() >= 20
        && d.cop.size() == 0 && d.freeWash.size() == 0
        && d.jumlahServis == 0 && d.ganjaran == 0 && d.kadSelesai == 0
        && d.telefon is string
        && getAfter(/databases/$(database)/documents/ahli_telefon/$(d.telefon)).data.token == token;
    }
    match /ahli/{token} {
      allow get: if true;
      allow list: if dalaman() || staffApp();
      allow delete: if dalaman();
      allow create: if dalaman() || sahAhliBaru(token);
      allow update: if dalaman() || request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['nama', 'emel', 'tarikhLahir', 'kenderaan', 'plat', 'cawanganUtama', 'setujuPromosi', 'dikemaskini', 'foto', 'tempahan'])
        || (staffApp() && request.resource.data.olehCaw in ['mama-lion', 'lion-king'] && olehKuasa(request.resource.data.olehCaw, 'kaunter')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cop', 'ganjaran', 'freeWash', 'kadSelesai', 'copTerakhir', 'jumlahServis', 'dikemaskini', 'olehId', 'olehCaw', 'kadAktif', 'kadAktifMasa', 'lawatan']));
      match /sejarah/{id} {
        allow read: if true;
        allow write: if dalaman();
        allow create: if staffApp() && request.resource.data.olehCaw in ['mama-lion', 'lion-king'] && olehKuasa(request.resource.data.olehCaw, 'kaunter');
      }
      // Status kenderaan semasa (dipaparkan dalam Apps Pelanggan)
      match /status/{id} {
        allow read: if true;
        allow write: if dalaman()
          || (staffApp() && ((request.resource.data.olehCaw in ['mama-lion', 'lion-king'] && olehKuasa(request.resource.data.olehCaw, 'kaunter'))
              || (request.resource.data.cawangan in ['mama-lion', 'lion-king'] && exists(/databases/$(database)/documents/lionsafari/$(request.resource.data.cawangan)/order/$(id)))));
      }
    }
    match /ahli_telefon/{tel} {
      allow get: if staffApp();
      allow read, update, delete: if dalaman();
      allow create: if dalaman() || (request.resource.data.token is string
        && getAfter(/databases/$(database)/documents/ahli/$(request.resource.data.token)).data.telefon == tel);
    }
    // Resit PDF untuk pelanggan (pautan WhatsApp): sesiapa dengan id rawak boleh buka
    match /resit_awam/{id} {
      allow get: if true;
      allow create: if dalaman() || staffApp();
      allow list, update, delete: if dalaman();
    }
    // Log masuk ahli: id = {telefon}_{plat} → {token}. Pelanggan hanya boleh cipta untuk kad sendiri (telefon & plat mesti sepadan)
    // Rekod pelanggan lama (import MONZ) — dibaca kaunter & Apps Pekerja, ditulis oleh Akaun / kaunter
    match /pelanggan_lama/{id} {
      allow read: if dalaman() || staffApp();
      allow write: if dalaman();
    }
    // Catatan dalaman & log tindakan ahli — Akaun / kaunter sahaja (pelanggan tidak boleh baca)
    match /ahli_nota/{id} {
      allow read, write: if dalaman();
    }
    match /ahli_log/{id} {
      allow read, create: if dalaman();
    }
    match /ahli_masuk/{kunci} {
      allow get: if true;
      allow list, delete: if dalaman();
      allow create, update: if dalaman() || staffApp()
        || (request.resource.data.keys().hasOnly(['token']) && request.resource.data.token is string
            && getAfter(/databases/$(database)/documents/ahli/$(request.resource.data.token)).data.telefon == kunci.split('_')[0]
            && kunci.split('_')[1] in getAfter(/databases/$(database)/documents/ahli/$(request.resource.data.token)).data.plat);
    }
    // Tetapan kad loyalti Safari Members (bil cop, Free Wash, syarat aktif) — diedit di Apps Akaun
    match /tetapan_ahli/{id} {
      allow read: if true;
      allow write: if dalaman();
    }
    match /promosi/{id} {
      allow read: if true;
      allow write: if dalaman();
      allow create, update: if staffApp()
        && request.resource.data.olehCaw in ['mama-lion', 'lion-king']
        && olehKuasa(request.resource.data.olehCaw, 'promosi');
    }
    // Apps Pelanggan baca pakej, harga & gambar pakej
    match /lionsafari/{cawangan}/tetapan/umum {
      allow read: if true;
    }
    match /lionsafari/{cawangan}/gambar/{id} {
      allow read: if true;
    }

    // Akaun Mama Lion (pemilik & pengurusan)
    match /akaun/mama-lion {
      function signedIn() {
        return request.auth != null;
      }
      function owner() {
        return signedIn() && exists(/databases/$(database)/documents/akaun/mama-lion/pemilik/$(request.auth.uid));
      }
      function operator() {
        return signedIn() && exists(/databases/$(database)/documents/akaun/mama-lion/pengurusan/$(request.auth.uid));
      }
      function assigned(data) {
        return operator() && data.assignedUid == request.auth.uid;
      }
      function validEntry(data) {
        return data.cawangan == 'mama-lion'
          && data.jenis in ['jualan', 'pembelian', 'belanja', 'petty']
          && data.amaun is number && data.amaun > 0
          && data.tarikh is string
          && data.tarikh.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && data.bulan is string
          && data.bulan.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && data.tarikh.matches(data.bulan + '-[0-9]{2}');
      }
      match /pemilik/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
      }
      match /pengurusan/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
      }
      match /entri/{id} {
        allow read: if owner() || kewanganSyarikat() || assigned(resource.data);
        allow create: if owner() || kewanganSyarikat() || (assigned(request.resource.data) && validEntry(request.resource.data));
        allow update: if owner() || kewanganSyarikat() || (assigned(resource.data) && assigned(request.resource.data)
          && validEntry(request.resource.data)
          && request.resource.data.jenis == resource.data.jenis
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['oleh', 'dicipta', 'sumber', 'ls_key']));
        allow delete: if owner();
      }
    }
  }
}
